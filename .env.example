# NARA Project Environment Variables
# Copy this file to .env.local and fill in your values

# 1. AI-Engine Specific Configuration
# If true, the recommendation engine strictly restricts all meal plans to local Indonesian dishes
INDONESIAN_ONLY=true

# 2. Database Configuration (Supabase / PostgreSQL)
# Used to store user profiles and generated meal plans persistently.
DATABASE_URL="postgresql://user:password@localhost:5432/nara_db"
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# 3. Google Vertex AI / Gemini Configuration (XAI Layer)
# Used for the Explainable AI Chatbot and Reasoning generation.
GEMINI_API_KEY="your_gemini_api_key_here"

# 4. Python AI-Engine Backend (Local Inference or Cloud Run)
# URL where your Python FastAPI/Flask server is running to process the Decision Tree
# and parse the 16k+ recipe dataset.
NEXT_PUBLIC_AI_ENGINE_URL="http://127.0.0.1:8000"

# 5. Security
# Secret key for encrypting sessions/cookies if using NextAuth
NEXTAUTH_SECRET="generate_a_random_string_here"
