# ==========================================
# NARA FRONTEND CONFIGURATION (Vercel / Local Next.js)
# ==========================================

# 1. Supabase (Database & Authentication)
# Used to persist user biometrics and generated meal plans.
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# 2. AI-Engine Connection (Python microservice on Railway or local)
NEXT_PUBLIC_AI_ENGINE_URL="http://127.0.0.1:8000"
# (Optional) Alternatively override using:
# PYTHON_MICROSERVICE_URL="https://your-railway-app.railway.app"

# 3. Client-side AES-GCM encryption key (localStorage biometric data)
# Generate a strong random string: openssl rand -base64 32
NEXT_PUBLIC_NARA_ENCRYPT_SECRET="generate_a_strong_random_string_here"

# 4. NextAuth Configuration (If used in future releases)
NEXTAUTH_SECRET="generate_a_random_string_here"


# ==========================================
# NARA BACKEND CONFIGURATION (Railway / Local Python Engine)
# ==========================================

# 1. Google Cloud / Vertex AI Agent Credentials
# Path to Google Service Account JSON file (only needed for local development).
# On Railway, you can inject the JSON contents as a string or use Cloud SDK buildpacks.
GOOGLE_APPLICATION_CREDENTIALS="path/to/service-account-key.json"
GOOGLE_CLOUD_PROJECT="your-gcp-project-id"
GOOGLE_CLOUD_LOCATION="asia-southeast1" # e.g. jakarta or us-central1

# 2. Constraint Settings
# If true, restricts all recommendations strictly to Indonesian local dishes.
INDONESIAN_ONLY=true
